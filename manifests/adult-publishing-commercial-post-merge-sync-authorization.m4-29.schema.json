{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tu1nz.invalid/schemas/adult-publishing-commercial-post-merge-sync-authorization.m4-29.schema.json",
  "title": "TU1NZ M4.29 post-merge sync target refresh and authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "active",
    "approval",
    "authorization_conditions",
    "blockers",
    "contract_path",
    "contract_version",
    "decision",
    "environment",
    "expected_historical_source",
    "fresh_observed_server_source",
    "historical_binding",
    "ignored_baseline",
    "mutation_ready_conditions",
    "post_merge_target",
    "product_boundary",
    "read_only_server_evidence",
    "release_binding",
    "rollback",
    "sprint",
    "sync_transaction"
  ],
  "properties": {
    "active": { "type": "boolean" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_at", "authorization_maximum_age_seconds", "first_start_approved", "fresh_server_evidence_present", "mutation_approved", "mutation_approved_at", "no_swap_risk_accepted", "operator_sync_approved", "separate_first_start_authorization_required", "server_contact_approved", "server_contact_approved_at", "source_observed_at", "source_sha", "source_tree_sha", "sync_approved"],
      "properties": {
        "approved_at": { "type": ["null", "string"] },
        "authorization_maximum_age_seconds": { "const": 300 },
        "first_start_approved": { "const": false },
        "fresh_server_evidence_present": { "type": "boolean" },
        "mutation_approved": { "type": "boolean" },
        "mutation_approved_at": { "type": ["null", "string"] },
        "no_swap_risk_accepted": { "const": false },
        "operator_sync_approved": { "type": "boolean" },
        "separate_first_start_authorization_required": { "const": true },
        "server_contact_approved": { "type": "boolean" },
        "server_contact_approved_at": { "type": ["null", "string"] },
        "source_observed_at": { "type": ["null", "string"] },
        "source_sha": { "type": ["null", "string"] },
        "source_tree_sha": { "type": ["null", "string"] },
        "sync_approved": { "type": "boolean" }
      }
    },
    "authorization_conditions": { "type": "object" },
    "blockers": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "contract_path": { "const": "manifests/adult-publishing-commercial-post-merge-sync-authorization.m4-29.json" },
    "contract_version": { "const": "tu1nz-commercial-post-merge-sync-authorization-m4.29-v1" },
    "decision": { "enum": ["NO_GO", "GO_READ_ONLY_SERVER_EVIDENCE_ONLY", "GO_SERVER_CONTROL_SYNC_ONLY"] },
    "environment": { "const": "STAGING-S0-COMMERCIAL-CANDIDATE" },
    "expected_historical_source": { "type": "object" },
    "fresh_observed_server_source": { "type": "object" },
    "historical_binding": { "type": "object" },
    "ignored_baseline": { "type": "object" },
    "mutation_ready_conditions": { "type": "object" },
    "post_merge_target": { "type": "object" },
    "product_boundary": { "type": "object" },
    "read_only_server_evidence": { "type": "object" },
    "release_binding": { "type": "object" },
    "rollback": { "type": "object" },
    "sprint": { "const": "M4.29" },
    "sync_transaction": { "type": "object" }
  }
}

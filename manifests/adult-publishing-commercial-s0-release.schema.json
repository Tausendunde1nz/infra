{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tu1nz.invalid/schemas/adult-publishing-commercial-s0-release.schema.json",
  "title": "TU1NZ Adult Publishing M4.19 commercial S0 release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_sha",
    "approved_utc",
    "archive_inventory_sha256",
    "archive_name",
    "archive_sha256",
    "backup_completed_at",
    "backup_member_roots",
    "commercial_contract_version",
    "control_sha",
    "dependency_lock_sha256",
    "environment",
    "external_providers_enabled",
    "local_source_required",
    "migration_hashes",
    "network_enabled",
    "paid_targets",
    "persistence_schema_version",
    "readiness_contract_sha256",
    "real_media_enabled",
    "real_payment_enabled",
    "release_contract_version",
    "required_platforms",
    "retention_days",
    "rpo_target_seconds",
    "rto_target_seconds",
    "runtime_version",
    "synthetic_data_only",
    "synthetic_publishers_only",
    "telegram_intake_enabled",
    "uncompensated_targets",
    "unit_sha256"
  ],
  "properties": {
    "application_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "approved_utc": { "type": "string", "format": "date-time" },
    "archive_inventory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "archive_name": { "type": "string", "pattern": "^tu1nz_system_backup_[A-Za-z0-9_.-]+\\.tar\\.gz$" },
    "archive_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "backup_completed_at": { "type": "string", "format": "date-time" },
    "backup_member_roots": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "commercial_contract_version": { "const": "tu1nz-commercial-persistence-m4.15-v1" },
    "control_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "dependency_lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environment": { "const": "STAGING-S0-COMMERCIAL-CANDIDATE" },
    "external_providers_enabled": { "const": false },
    "local_source_required": { "const": true },
    "migration_hashes": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "pattern": "^migrations/[A-Za-z0-9_.-]+\\.sql$" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "network_enabled": { "const": false },
    "paid_targets": { "const": ["REDDIT", "TELEGRAM"] },
    "persistence_schema_version": { "const": "0014_m4_15_durable_commercial_persistence" },
    "readiness_contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "real_media_enabled": { "const": false },
    "real_payment_enabled": { "const": false },
    "release_contract_version": { "const": "tu1nz-commercial-s0-installation-m4.19-v1" },
    "required_platforms": { "const": ["REDDIT", "TELEGRAM", "X"] },
    "retention_days": { "type": "integer", "minimum": 1 },
    "rpo_target_seconds": { "type": "integer", "minimum": 1 },
    "rto_target_seconds": { "type": "integer", "minimum": 1 },
    "runtime_version": { "const": "tu1nz-commercial-runtime-candidate-m4.17-v1" },
    "synthetic_data_only": { "const": true },
    "synthetic_publishers_only": { "const": true },
    "telegram_intake_enabled": { "const": false },
    "uncompensated_targets": { "const": ["X"] },
    "unit_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

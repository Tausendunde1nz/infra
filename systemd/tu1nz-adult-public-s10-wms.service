[Unit]
Description=Want Me Seen S10.1 public SFW landing
After=tu1nz-adult-public-s7.service tu1nz-adult-public-s8-telegram.service
Requires=tu1nz-adult-public-s7.service
StartLimitBurst=3
StartLimitIntervalSec=15min

[Service]
Type=simple
User=chatops
Group=chatops
WorkingDirectory=/opt/tu1nz_repos/adult-publishing-core
ExecStart=/usr/bin/env PYTHONPATH=/opt/tu1nz_repos/adult-publishing-core/src /opt/tu1nz_repos/adult-publishing-core/.venv/bin/python -m tu1nz_exposure_s10.runtime --contract /etc/tu1nz/adult-commercial-s10-wms.json --copy /etc/tu1nz/adult-commercial-s10-wms-copy.json --bot-contract /etc/tu1nz/adult-commercial-s10-wms-bot-identity.json --aggregate-state /var/lib/tu1nz-adult-public-s9/landing-aggregates.json
Restart=on-failure
RestartSec=15s
StateDirectory=tu1nz-adult-public-s9
StateDirectoryMode=0700
ReadWritePaths=/var/lib/tu1nz-adult-public-s9
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target

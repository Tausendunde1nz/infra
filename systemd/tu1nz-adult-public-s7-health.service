[Unit]
Description=TU1NZ Adult Publishing S7 public health check
After=tu1nz-adult-public-s7.service

[Service]
Type=oneshot
User=chatops
Group=chatops
ExecStart=/usr/local/bin/tu1nz_adult_public_s7_health.py
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

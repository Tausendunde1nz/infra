[Unit]
Description=TU1NZ Adult Publishing persistent Telegram STAGING-S1
Documentation=file:/opt/tu1nz_repos/releases/adult-publishing/staging-s1/control-current/docs/M3_9_PERSISTENT_TELEGRAM_STAGING_S1_2026-08-27.md
Wants=network-online.target
After=network-online.target postgresql.service
Requires=postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5
ConditionPathExists=/etc/tu1nz/adult-publishing/staging-s1/release-manifest.json
ConditionPathExists=/etc/tu1nz/adult-publishing/staging-s1/runtime.env

[Service]
Type=simple
User=tu1nz-adult-s1
Group=tu1nz-adult-s1
WorkingDirectory=/opt/tu1nz_repos/releases/adult-publishing/staging-s1/application-current
EnvironmentFile=/etc/tu1nz/adult-publishing/staging-s1/runtime.env
ExecStartPre=/usr/bin/python3 /opt/tu1nz_repos/releases/adult-publishing/staging-s1/control-current/scripts/tu1nz_adult_s1_release_gate.py --manifest /etc/tu1nz/adult-publishing/staging-s1/release-manifest.json --application-repository /opt/tu1nz_repos/releases/adult-publishing/staging-s1/application-current --control-repository /opt/tu1nz_repos/releases/adult-publishing/staging-s1/control-current --application-release-root /opt/tu1nz_repos/releases/adult-publishing/staging-s1/application --control-release-root /opt/tu1nz_repos/releases/adult-publishing/staging-s1/control --venv /opt/tu1nz_repos/releases/adult-publishing/staging-s1/venv-current --configuration-root /etc/tu1nz/adult-publishing/staging-s1 --state-root /var/lib/tausendunde1nz/adult-publishing/staging-s1 --installed-unit /etc/systemd/system/tu1nz-adult-publishing-s1.service --runtime-user tu1nz-adult-s1 --runtime-group tu1nz-adult-s1 --release-user root --configuration-user root --unit-user root --unit-group root --require-active
ExecStart=/opt/tu1nz_repos/releases/adult-publishing/staging-s1/venv-current/bin/tu1nz-adult-sandbox --mode telegram-staging-s1 --enable-external-telegram-sandbox --enable-persistent-telegram-staging-s1 --enable-postgres-s0-core --state-file /var/lib/tausendunde1nz/adult-publishing/staging-s1/state.json --media-root /var/lib/tausendunde1nz/adult-publishing/staging-s1/media --media-registry /etc/tu1nz/adult-publishing/staging-s1/media-registry.json --identity-policy /etc/tu1nz/adult-publishing/staging-s1/identity-policy.json --subject-key-file /etc/tu1nz/adult-publishing/staging-s1/subject-key --telegram-offset-file /var/lib/tausendunde1nz/adult-publishing/staging-s1/telegram-offset.json --core-identity-registry /etc/tu1nz/adult-publishing/staging-s1/core-identities.json --runtime-status-file /var/lib/tausendunde1nz/adult-publishing/staging-s1/runtime-status.json --runtime-lock-file /var/lib/tausendunde1nz/adult-publishing/staging-s1/runtime.lock
Restart=on-failure
RestartSec=15s
TimeoutStartSec=60s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/etc/tu1nz/adult-publishing/staging-s1 /opt/tu1nz_repos/releases/adult-publishing/staging-s1
ReadWritePaths=/var/lib/tausendunde1nz/adult-publishing/staging-s1
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io

[Install]
WantedBy=multi-user.target

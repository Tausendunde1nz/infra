[Unit]
Description=TU1NZ S12.1 bounded Yoti Sandbox acceptance
After=network-online.target nginx.service
Wants=network-online.target
Requires=nginx.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=chatops
WorkingDirectory=/etc/tu1nz/adult-commercial-s12-1-private/release/application
Environment=PYTHONPATH=/etc/tu1nz/adult-commercial-s12-1-private/release/application/src
Environment=GIT_OPTIONAL_LOCKS=0
LoadCredential=yoti-sdk-id:/etc/tu1nz/adult-commercial-s5.yoti-sdk-id
LoadCredential=yoti-private-key:/etc/tu1nz/adult-commercial-s5.yoti-private-key
LoadCredential=s12-runtime-contract:/etc/tu1nz/adult-commercial-s12-1-yoti-runtime.json
ExecStart=/etc/tu1nz/adult-commercial-s12-1-private/release/venv/bin/python -m tu1nz_s12.runtime acceptance-start --contract /run/credentials/tu1nz-adult-commercial-s12-yoti-runtime.service/s12-runtime-contract --credential-directory /run/credentials/tu1nz-adult-commercial-s12-yoti-runtime.service --application-root /etc/tu1nz/adult-commercial-s12-1-private/release/application --control-root /etc/tu1nz/adult-commercial-s12-1-private/release/control --state-directory /etc/tu1nz/adult-commercial-s12-1-private/state --evidence-file /etc/tu1nz/adult-commercial-s12-1-private/state/acceptance.json --callback-bind 127.0.0.1 --callback-port 18126
ExecStartPost=/etc/tu1nz/adult-commercial-s12-1-private/release/venv/bin/python -m tu1nz_s12.runtime safe-stop --contract /run/credentials/tu1nz-adult-commercial-s12-yoti-runtime.service/s12-runtime-contract --credential-directory /run/credentials/tu1nz-adult-commercial-s12-yoti-runtime.service --application-root /etc/tu1nz/adult-commercial-s12-1-private/release/application --control-root /etc/tu1nz/adult-commercial-s12-1-private/release/control --state-directory /etc/tu1nz/adult-commercial-s12-1-private/state --evidence-file /etc/tu1nz/adult-commercial-s12-1-private/state/final-state.json
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/tu1nz_repos
ReadWritePaths=/etc/tu1nz/adult-commercial-s12-1-private/state
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
TimeoutStartSec=15min

[Install]
WantedBy=

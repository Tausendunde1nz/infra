[Unit]
Description=TU1NZ S10.1 reconcile one proven legacy SFW Telegram publication
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=chatops
Group=chatops
WorkingDirectory=/opt/tu1nz_repos/adult-publishing-core
LoadCredential=s9_database_dsn:/etc/tu1nz/adult-commercial-s7-database.dsn
ExecStart=/opt/tu1nz_repos/adult-publishing-core/.venv/bin/tu1nz-commercial-s9-growth --contract /etc/tu1nz/adult-commercial-s9-growth.json --database-dsn %d/s9_database_dsn --reconcile-publication --telegram-channel @tu1nz_adult_publishing --provider-post-id 2 --public-text-sha256 1e776a4a514d04749b0565a91dc8f007cd8ab4b702c027090eb91754257d9324
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
